<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- App Bar / Top Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="180"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert Details"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomActions"
        android:padding="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Alert Main Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlertDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#1A101C"
                app:strokeColor="#521525"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/layoutRiskBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#2E1219"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:id="@+id/imgRiskIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_warning"
                            app:tint="#FF3B30"/>

                        <TextView
                            android:id="@+id/txtRiskBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High Risk"
                            android:textColor="#FF3B30"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtAlertTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy Alert"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <!-- Details Table -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <!-- App Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="App"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:layout_centerVertical="true"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end"
                                android:layout_alignParentEnd="true">

                                <ImageView
                                    android:id="@+id/imgAppIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_apps"
                                    android:visibility="gone"/>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="end">

                                    <TextView
                                        android:id="@+id/txtAppName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Application"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:id="@+id/txtPackageName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="package.name"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp"
                                        android:visibility="gone"/>
                                </LinearLayout>
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Permissions Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Permissions"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/txtPermission"
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:text="Standard Permissions"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>

                        <!-- Time Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Time"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/txtTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recent"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>

                    </LinearLayout>

                    <!-- Reason -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Risk Reason / Summary"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/txtReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Application analysis details."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="4dp"/>

                    <!-- AI Recommendation Box -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#231728"
                        app:strokeColor="#3D2045"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI Recommendation"
                                android:textColor="#E040FB"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtAiRecommendation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Review permission access in system settings."
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:lineSpacingExtra="2dp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:padding="20dp"
        android:background="#0A0F1D">

        <Button
            android:id="@+id/btnRestrictApp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="OPEN APP SETTINGS"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glow_button"/>

        <Button
            android:id="@+id/btnViewAppAnalysis"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="VIEW FULL APP ANALYSIS"
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:background="@drawable/bg_outline_button"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnIgnore"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="MARK AS REVIEWED"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</RelativeLayout>
